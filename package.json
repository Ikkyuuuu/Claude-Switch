{
  "name": "claude-switch-accounts",
  "displayName": "Claude Switch",
  "description": "Switch which Claude account the Claude Code extension and CLI use. Not affiliated with Anthropic.",
  "version": "0.14.1",
  "publisher": "wattanun42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ikkyuuuu/Claude-Switch.git"
  },
  "bugs": {
    "url": "https://github.com/Ikkyuuuu/Claude-Switch/issues"
  },
  "homepage": "https://github.com/Ikkyuuuu/Claude-Switch#readme",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1F3A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitch",
          "title": "Claude Switch",
          "icon": "resources/switch.svg"
        }
      ]
    },
    "views": {
      "claudeSwitch": [
        {
          "type": "webview",
          "id": "claudeSwitch.accounts",
          "name": "Accounts",
          "icon": "resources/switch.svg",
          "contextualTitle": "Claude Switch"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSwitch.switch",
        "title": "Switch This Window's Account",
        "category": "Claude Switch",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeSwitch.switchAll",
        "title": "Switch All Windows",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.add",
        "title": "Add Account",
        "category": "Claude Switch",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitch.rename",
        "title": "Edit Account",
        "category": "Claude Switch",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitch.remove",
        "title": "Remove Account",
        "category": "Claude Switch",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitch.setRenewal",
        "title": "Set Renewal Date",
        "category": "Claude Switch",
        "icon": "$(calendar)"
      },
      {
        "command": "claudeSwitch.saveCurrent",
        "title": "Save Current Login",
        "category": "Claude Switch",
        "icon": "$(save)"
      },
      {
        "command": "claudeSwitch.recapture",
        "title": "Re-capture Current Login",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.restore",
        "title": "Restore Last Backup",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.refresh",
        "title": "Refresh",
        "category": "Claude Switch",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitch.showLog",
        "title": "Show Log",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.forgetAll",
        "title": "Remove All Saved Data",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.signIn.openPage",
        "title": "Open Sign-in Page",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.signIn.copyLink",
        "title": "Copy Sign-in Link",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.signIn.pasteCode",
        "title": "Paste Sign-in Code",
        "category": "Claude Switch"
      },
      {
        "command": "claudeSwitch.signIn.cancel",
        "title": "Cancel Sign-in",
        "category": "Claude Switch"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeSwitch.signIn.openPage",
          "when": "claudeSwitch.signingIn"
        },
        {
          "command": "claudeSwitch.signIn.copyLink",
          "when": "claudeSwitch.signingIn"
        },
        {
          "command": "claudeSwitch.signIn.pasteCode",
          "when": "claudeSwitch.signingIn"
        },
        {
          "command": "claudeSwitch.signIn.cancel",
          "when": "claudeSwitch.signingIn"
        }
      ],
      "view/title": [
        {
          "command": "claudeSwitch.add",
          "when": "view == claudeSwitch.accounts",
          "group": "navigation@1"
        },
        {
          "command": "claudeSwitch.refresh",
          "when": "view == claudeSwitch.accounts",
          "group": "navigation@2"
        },
        {
          "command": "claudeSwitch.switchAll",
          "when": "view == claudeSwitch.accounts",
          "group": "0_switch@1"
        },
        {
          "command": "claudeSwitch.recapture",
          "when": "view == claudeSwitch.accounts",
          "group": "1_login@1"
        },
        {
          "command": "claudeSwitch.restore",
          "when": "view == claudeSwitch.accounts",
          "group": "1_login@2"
        },
        {
          "command": "claudeSwitch.showLog",
          "when": "view == claudeSwitch.accounts",
          "group": "2_log@1"
        },
        {
          "command": "claudeSwitch.forgetAll",
          "when": "view == claudeSwitch.accounts",
          "group": "3_data@1"
        }
      ],
      "webview/context": [
        {
          "command": "claudeSwitch.switch",
          "when": "webviewId == 'claudeSwitch.accounts' && webviewSection == 'profile'",
          "group": "1_switch@1"
        },
        {
          "command": "claudeSwitch.switchAll",
          "when": "webviewId == 'claudeSwitch.accounts' && webviewSection =~ /^(profile|activeProfile)$/",
          "group": "1_switch@2"
        },
        {
          "command": "claudeSwitch.rename",
          "when": "webviewId == 'claudeSwitch.accounts' && webviewSection =~ /^(profile|activeProfile)$/",
          "group": "2_edit@1"
        },
        {
          "command": "claudeSwitch.remove",
          "when": "webviewId == 'claudeSwitch.accounts' && webviewSection == 'profile'",
          "group": "2_edit@2"
        },
        {
          "command": "claudeSwitch.setRenewal",
          "when": "webviewId == 'claudeSwitch.accounts' && webviewSection =~ /^(profile|activeProfile)$/",
          "group": "2_edit@3"
        }
      ]
    },
    "configuration": {
      "title": "Claude Switch",
      "properties": {
        "claudeSwitch.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the Claude Code CLI that Claude Switch runs: to sign in with **Add Account**, and for usage checks. Leave empty to use the CLI bundled with the Claude Code extension, or `claude` on PATH. User settings only; workspace settings cannot change it."
        },
        "claudeSwitch.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Ask for confirmation before switching accounts when `#claudeSwitch.switchMode#` restarts extensions or reloads the window. Instant switches never ask."
        },
        "claudeSwitch.switchMode": {
          "type": "string",
          "default": "reloadWindow",
          "enum": [
            "reloadWindow",
            "restartExtensions",
            "newConversation",
            "instant"
          ],
          "enumDescriptions": [
            "Close and reopen the window after switching, so every Claude Code conversation in it restarts on the new account. The most reliable.",
            "Restart VS Code extensions (a few seconds; editors and terminals stay open), so every Claude Code conversation in this window uses the new account.",
            "Switch without restarting and open a new Claude Code conversation on the new account. Conversations that were already open keep the old account. After Switch All Windows, they can also write it back.",
            "Switch without restarting. New Claude Code conversations use the new account; open ones keep the old account. After Switch All Windows, they can also write it back."
          ],
          "scope": "application",
          "markdownDescription": "What happens in the window that switches, after a switch (other windows keep their accounts unless you use **Switch All Windows**). By default the window reloads, so no Claude Code conversation is left running on the old account. The instant modes are faster, but conversations and terminals that were already open keep the old account until you start new ones."
        },
        "claudeSwitch.usageCheckSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "How often, in seconds, Claude Switch asks Claude Code for the current usage of this window's account while Claude is idle. A few seconds after Claude replies, in any window, it checks anyway, so the numbers follow your use; this setting catches usage elsewhere, such as on claude.ai. The VS Code window you are in does the checks, for the account that replied, and every window shows the result. Claude Code's own CLI fetches the numbers, the way its Account & Usage panel does; Claude Switch never handles your token or makes the request itself. If a check fails, for example because Anthropic is limiting requests, the next one waits longer. `0` turns usage checks off; values below 10 count as 10."
        },
        "claudeSwitch.autoRefreshSeconds": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "How often, in seconds, the Claude Switch tab and status bar re-read the login while the window is focused, so a switch in another window or a `/login` shows at once. These are local file reads; nothing is sent over the network. Usage is checked separately, see `#claudeSwitch.usageCheckSeconds#`. `0` turns auto-refresh off."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc -p src/webview",
    "lint": "eslint src test",
    "compile-tests": "tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration": "npm run compile-tests && node esbuild.js && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "vsix": "vsce package --allow-star-activation"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "mocha": "^11.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "keywords": [
    "claude",
    "claude code",
    "account",
    "switcher",
    "multiple accounts",
    "usage",
    "profiles"
  ]
}
